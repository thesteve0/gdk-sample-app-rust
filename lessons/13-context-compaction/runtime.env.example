# Nonsecret example only; never replace the reader connection with the admin one.
# In your private prepared shell, source connection.env and run:
# export RETRIEVAL_DATABASE_URL="$READER_DATABASE_URL"
HARRIER_URL=http://127.0.0.1:9999
TUTOR_URL=http://127.0.0.1:8080
# TUTOR_URL must match your literal-loopback provider JSON origin and expose /tokenize.
# Never commit actual database credentials or private excerpts.

# Conservative application estimated-byte threshold, NOT a model-token limit.
# Positive value at most84000 (100000 total minus16000 reserved headroom).
COMPACTION_TRIGGER_BYTES=60000
