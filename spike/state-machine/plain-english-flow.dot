digraph PlainEnglish {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.4, fontname="DejaVu Sans", fontsize=19, labelloc=t, label="Read → act → save → read again\nOne question, one answer — normal successful path"];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b", fontname="DejaVu Sans", fontsize=14, margin="0.18,0.14"];
  edge [fontname="DejaVu Sans", fontsize=12, color="#475569", fontcolor="#334155", penwidth=1.5];
  prepare [label="Prepare the pieces.\nKeep the question."];
  start [label="Tell the State-Machine to start."];
  read [label="Read the Session."];
  check [shape=diamond, label="Try the available Operators in order.\nDoes any Operator have work to do?", fillcolor="#fef3c7", color="#d97706"];
  work [label="Let that Operator finish.\nSave its returned changes.", fillcolor="#dcfce7", color="#16a34a"];
  done [label="Return to the program.\nThe program shows the answer.", fillcolor="#dbeafe", color="#2563eb"];
  prepare -> start -> read -> check;
  check -> work [label="YES\nThe question needs a reply."];
  work -> read [label="Read again after saving.", color="#16a34a", fontcolor="#15803d"];
  check -> done [label="NO\nEvery Operator declines."];
}
